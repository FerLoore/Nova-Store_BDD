-- 1. PERMISOS
CREATE TABLE NOVA_PERMISO (
    PERM_PERMISO     NUMBER PRIMARY KEY,
    PERM_CODIGO      VARCHAR2(50) NOT NULL UNIQUE,
    PERM_DESCRIPCION VARCHAR2(150)
);

CREATE TABLE NOVA_ROL_PERMISO (
    ROL_ROL      NUMBER NOT NULL REFERENCES NOVA_ROL(ROL_ROL),
    PERM_PERMISO NUMBER NOT NULL REFERENCES NOVA_PERMISO(PERM_PERMISO),
    CONSTRAINT PK_ROL_PERMISO PRIMARY KEY (ROL_ROL, PERM_PERMISO)
);

CREATE SEQUENCE SEQ_PERM START WITH 1 INCREMENT BY 1 NOCACHE;

CREATE OR REPLACE TRIGGER TRG_PERM_BI
BEFORE INSERT ON NOVA_PERMISO
FOR EACH ROW
WHEN (NEW.PERM_PERMISO IS NULL)
BEGIN
    :NEW.PERM_PERMISO := SEQ_PERM.NEXTVAL;
END;
/

-- 2. CLIENTES
ALTER TABLE NOVA_CLIENTE ADD (
    CLI_ACTIVO NUMBER(1) DEFAULT 1 NOT NULL CHECK (CLI_ACTIVO IN (0,1)),
    CLI_CREADO TIMESTAMP DEFAULT SYSTIMESTAMP NOT NULL
);
ALTER TABLE NOVA_CLIENTE ADD CONSTRAINT UQ_CLI_DPI_NIT UNIQUE (CLI_DPI_NIT);
ALTER TABLE NOVA_CLIENTE ADD CONSTRAINT UQ_CLI_CORREO  UNIQUE (CLI_CORREO);

-- 3. VALIDACIONES EN PRODUCTO/VARIANTE
ALTER TABLE NOVA_VARIANTE ADD CONSTRAINT CK_VAR_VALORES
    CHECK (VAR_PRECIO_COMPRA >= 0 AND VAR_PRECIO_VENTA >= 0 AND VAR_STOCK_MINIMO >= 0);

